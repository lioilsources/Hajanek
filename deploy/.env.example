# hajanek-api — copy to .env (never commit .env).
# Generate tokens with: openssl rand -hex 32

# Bearer token for POST/GET /v1/jobs (admin, forge cron).
ADMIN_TOKEN=change-me-admin
# Bearer token for the Spark worker (claim / heartbeat / complete). Must differ from ADMIN_TOKEN.
WORKER_TOKEN=change-me-worker

# Published catalog on GitHub Pages and how often to poll it.
CATALOG_URL=https://lioilsources.github.io/hajanek-content/catalog.json
CATALOG_POLL=5m

# Optional job queue tuning.
# JOB_LEASE=10m
# JOB_MAX_ATTEMPTS=3
# REAPER_INTERVAL=30s

# Parent voices (ADR-003). DATA_DIR is set in docker-compose.yml (/data/files).
# Max voices per device (deleting ones don't count).
# MAX_VOICES_PER_DEVICE=3
# POST /v1/devices per client IP: N/duration token bucket, or "off".
# DEVICE_RATE_LIMIT=10/1h
