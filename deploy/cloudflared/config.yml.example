# Copy to config.yml and fill in the tunnel id (from `cloudflared tunnel create hajanek`).
# The credentials JSON goes next to it and must never be committed.
tunnel: <TUNNEL-ID>
credentials-file: /etc/cloudflared/<TUNNEL-ID>.json

ingress:
  - hostname: hajanek-api.ol1n.com
    service: http://caddy:80
    originRequest:
      connectTimeout: 30s
      httpHostHeader: hajanek-api.ol1n.com
  - service: http_status:404
