# TLS terminates at Cloudflare; the tunnel talks plain HTTP to Caddy.
{
	admin off
	auto_https off
}

http://hajanek-api.ol1n.com {
	encode zstd gzip

	# Voice samples are up to 5 MB (multipart), worker clips up to 2 MB.
	request_body {
		max_size 6MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	reverse_proxy hajanek-api:8080 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	log {
		output stdout
		format json
	}
}
